{
  "name": "ui-path-recorder",
  "version": "0.2.0",
  "description": "Record a reproducible path through a live UI and publish documentation-quality figures from it.",
  "license": "MIT",
  "author": "Maciej Kucharz",
  "type": "module",
  "keywords": [
    "playwright",
    "screenshots",
    "documentation",
    "tutorial",
    "walkthrough",
    "screencast",
    "agent-skill"
  ],
  "bin": {
    "path-shots": "scripts/path-shots.mjs"
  },
  "files": [
    "SKILL.md",
    "scripts/",
    "lib/",
    "plans/schema.json",
    "references/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "for f in scripts/path-shots.mjs lib/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done; echo 'syntax ok'",
    "shots": "node scripts/path-shots.mjs",
    "ingest": "node lib/ingest.mjs",
    "prepare": "node --check scripts/path-shots.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.65.1"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=20"
  }
}
