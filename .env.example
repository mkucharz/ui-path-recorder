# Copy to `.env` and fill in — `.env` is gitignored, this file is not.
#
# The recorder loads `.env` from the directory it is run in, and never overrides
# a variable that is already in the environment. Nothing here is required for the
# default engine (`say`, macOS's own voice); the key is only for
# `--narration-engine elevenlabs`.

# elevenlabs.io → profile → API keys. The text-to-speech permission is enough:
# a key that cannot list voices still works when `voice` is an id.
ELEVENLABS_API_KEY=

# The voice to speak with when a plan does not name one. An id, not a name —
# resolving a name needs the `voices_read` permission. Adam is the premade
# default and works on a free workspace.
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# A plan's `baseUrl` expands `${SIGNIN_URL}`-style variables from the
# environment, so the URL a walkthrough drives can live here too.
# SIGNIN_URL=http://127.0.0.1:8100
