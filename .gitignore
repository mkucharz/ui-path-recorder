# Run output: a capture is a reviewable artefact, not a source file.
captures/

# A browser profile that holds a signed-in session. Never leaves the host, never
# enters git — it is a credential.
.profile/

# The documentation site as built (recorded examples + rendered page). The page
# template is `site/`; this is what `npm run site:build` records into it.
.site/

node_modules/
*.log
.DS_Store

# Playwright artefacts that are large and per-run.
trace.zip
video/
